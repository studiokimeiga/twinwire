{
  "name": "twinwire",
  "version": "3.0.1",
  "description": "Browser multiplayer with resumable sessions, WebSocket/WebRTC and optional WebTransport, ordered events, latest state, latency tracing, independent resources, lobbies and netcode helpers.",
  "keywords": [
    "multiplayer",
    "netcode",
    "game",
    "gamedev",
    "webrtc",
    "websocket",
    "webtransport",
    "datachannel",
    "udp",
    "lobby",
    "matchmaking",
    "snapshot-interpolation",
    "client-side-prediction",
    "turn",
    "stun",
    "browser",
    "safari"
  ],
  "homepage": "https://studiokimeiga.github.io/twinwire/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiokimeiga/twinwire.git"
  },
  "bugs": {
    "url": "https://github.com/studiokimeiga/twinwire/issues"
  },
  "author": {
    "name": "Hakan Alpay",
    "url": "https://github.com/Kimeiga"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./netcode": {
      "types": "./dist/netcode/index.d.ts",
      "import": "./dist/netcode/index.js"
    },
    "./browser": {
      "import": "./dist/browser/twinwire.mjs",
      "default": "./dist/browser/twinwire.js"
    },
    "./package.json": "./package.json",
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CITATION.cff",
    "SUPPORT.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && node tools/bundle.mjs",
    "check": "npm run build && npm test",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "node tools/browser-e2e.mjs",
    "test:native": "node tools/native-rtc-test.mjs",
    "bench": "node tools/bench.mjs",
    "budget": "node tools/budget.mjs",
    "demo": "node examples/arena/server.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run test:native",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "example": "node examples/party/server.mjs",
    "test:example": "node tools/party-e2e.mjs",
    "soak": "node --expose-gc tools/soak.mjs",
    "test:worker": "node tools/worker-e2e.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@fails-components/webtransport": ">=1.6.11 <2",
    "@fails-components/webtransport-transport-http3-quiche": ">=1.6.11 <2",
    "node-datachannel": ">=0.33.4 <0.34.0"
  },
  "peerDependenciesMeta": {
    "@fails-components/webtransport": {
      "optional": true
    },
    "@fails-components/webtransport-transport-http3-quiche": {
      "optional": true
    },
    "node-datachannel": {
      "optional": true
    }
  },
  "overrides": {
    "ws": "$ws",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@fails-components/webtransport": "1.6.11",
    "@fails-components/webtransport-transport-http3-quiche": "1.6.11",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260317.0",
    "node-datachannel": "^0.33.4",
    "playwright": "^1.63.0",
    "typescript": "~5.8.3"
  }
}
